# LectureScribe — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git

# === Groq API (Whisper transcription + LLM calls) ===
GROQ_API_KEY=your_groq_api_key_here

# === LLM API (Notes generation + Tutor) ===
LLM_API_KEY=your_llm_api_key_here

# === HuggingFace (Griot Nano 1 model download) ===
HF_TOKEN=your_huggingface_token_here

# === Griot Sidecar ===
GRIOT_SIDECAR_URL=http://localhost:8001

# === Authentication ===
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/lecturescribe

# === Server ===
PORT=5000
NODE_ENV=development
